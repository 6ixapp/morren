# Server Configuration
PORT=5000
NODE_ENV=production

# Database
# Local: install PostgreSQL, create a DB, then use postgresql://user:password@127.0.0.1:5432/your_db
# Railway: add PostgreSQL in project and reference DATABASE_URL from the Postgres service
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/morren_db

# JWT Configuration (CHANGE THESE IN PRODUCTION!)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# CORS Configuration (Update with your frontend URL)
CORS_ORIGIN=https://your-frontend-app.vercel.app

# OneSignal Push Notifications
# Get these from your OneSignal dashboard: https://onesignal.com
ONESIGNAL_APP_ID=your-onesignal-app-id
ONESIGNAL_REST_API_KEY=your-onesignal-rest-api-key
