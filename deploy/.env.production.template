# ============================================================
# Morren Marketplace - Production Environment Variables
# Copy to /opt/morren/.env and fill in values
# ============================================================

# Server
PORT=5000
NODE_ENV=production

# PostgreSQL Database
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://morren_user:YOUR_DB_PASSWORD@localhost:5432/morren_db

# JWT Authentication
# Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# CORS - Your Vercel frontend URL
# If no domain yet, use: http://YOUR_DROPLET_IP for testing
CORS_ORIGIN=https://your-app.vercel.app

# OneSignal Push Notifications (optional)
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
